# ============================================================
# Super-Agent Phase 1 MVP Configuration
# Copy this file to .env and update secrets before running.
# ============================================================

# Gateway HTTP listen port
GATEWAY_PORT=8080

# Required: strong random secret for signing JWT session cookies
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Token TTL in hours (default: 24)
JWT_TTL_HOURS=24

# Set to true when deploying behind HTTPS (e.g. Caddy / Nginx / Cloudflare)
COOKIE_SECURE=false

# MVP static user list: comma-separated username:password pairs
# Example: alice:StrongPass1!,bob:StrongPass2!
AUTH_USERS=admin:admin123,demo:demo123

# Docker orchestration settings
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=super-agent-net
DESKTOP_IMAGE=super-agent-desktop:latest

# Per-user container resource limits (6GB+ recommended when running ChatGPT/Claude GUI apps)
# CPU is a cap, not a reservation: 4 cores lets the software x264 encoder + Chrome
# breathe on multi-core hosts. If the host only has 2 cores total, set this to 2.
DESKTOP_MEMORY_MB=6144
DESKTOP_CPUS=4
DESKTOP_SHM_MB=2048
DESKTOP_TZ=Asia/Shanghai

# Optional: initial desktop display scaling, UI font size, and theme (dark | light)
# Defaults inside container: 115 DPI (125% comfortable), 11pt UI font, dark theme
# Can also be adjusted live anytime via the desktop "显示与字号设置" icon or `sa-display`
DESKTOP_DPI=
DESKTOP_FONT_SIZE=
DESKTOP_THEME=

# Container startup readiness timeout & idle auto-pause (0 disables auto-pause)
DESKTOP_START_TIMEOUT_SEC=60
DESKTOP_IDLE_PAUSE_MIN=30

# Streaming performance profile: smooth (default, latency-first) or quality.
# smooth = CBR + congestion control, streaming mode, paint-over off, 30fps,
# 1280x720 locked resolution, striped x264 encoder, small backpressure queue.
# quality = the old defaults (CRF, paint-over on, no streaming mode, free resize).
# Individual SELKIES_* vars below override the profile; SELKIES_EXTRA_ENV overrides all.
DESKTOP_PERFORMANCE_PROFILE=smooth
SELKIES_USE_PAINT_OVER_QUALITY=false
SELKIES_VIDEO_STREAMING_MODE=true
SELKIES_RATE_CONTROL_MODE=cbr
SELKIES_VIDEO_BITRATE=2500
SELKIES_FRAMERATE=30
SELKIES_ENCODER=h264enc-striped,h264enc,jpeg
SELKIES_MANUAL_WIDTH=1280
SELKIES_MANUAL_HEIGHT=720
SELKIES_ENABLE_RESIZE=false
SELKIES_BACKPRESSURE_QUEUE_SIZE=30
SELKIES_CONGESTION_CONTROL=true
SELKIES_EXTRA_ENV=

# Phase 2: Shared workspace directory for bidirectional sync daemon
# Mount the same host directory into the gateway (-v /data/workspaces:/data/workspaces)
# and set WORKSPACE_HOST_DIR to that host path so desktop containers share /workspace directly.
WORKSPACE_DATA_DIR=/data/workspaces
WORKSPACE_HOST_DIR=
SYNC_LOCK_TTL_SEC=60

# Optional: inject AI provider keys & model overrides dynamically into user containers
# Keys are injected as runtime env vars and never written to /workspace
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_SMALL_FAST_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
CODEX_MODEL=
