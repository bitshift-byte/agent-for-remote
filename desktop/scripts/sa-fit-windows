#!/usr/bin/env bash
# Snap and fit all overflowing application windows strictly inside the current desktop work area.
set -euo pipefail

if [ -x /usr/local/bin/sa-window-guard ]; then
  exec /usr/local/bin/sa-window-guard --once
fi

if ! command -v wmctrl >/dev/null 2>&1; then
  echo "wmctrl is not installed." >&2
  exit 1
fi

wmctrl -l | while read -r wid desk _host _title; do
  if [ "${desk}" = "-1" ]; then
    continue
  fi
  wmctrl -i -r "${wid}" -b add,maximized_vert,maximized_horz || true
done
