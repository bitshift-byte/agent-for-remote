#!/usr/bin/env python3
"""
Super-Agent Cloud Localhost Preview Helper (sa-preview)
Exposes a dev server running on your connected local Mac/Windows machine inside the cloud
desktop's localhost so cloud Chrome / Playwright / curl can live-preview it seamlessly.

Usage:
  sa-preview 3000          # forwards cloud http://localhost:3000 -> local machine port 3000
  sa-preview 3000 8080     # forwards cloud http://localhost:8080 -> local machine port 3000
"""
import http.server
import os
import socketserver
import sys
import urllib.error
import urllib.request


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Usage: sa-preview <local-machine-port> [cloud-listen-port]")
        sys.exit(0)

    local_port = int(sys.argv[1])
    cloud_port = int(sys.argv[2]) if len(sys.argv) >= 3 else local_port
    gateway_url = os.environ.get("SA_GATEWAY_URL", "").rstrip("/")
    token = os.environ.get("SA_INTERNAL_TOKEN", "")
    if not gateway_url or not token:
        print("Error: SA_GATEWAY_URL or SA_INTERNAL_TOKEN is not set in this container.", file=sys.stderr)
        sys.exit(1)

    class PreviewHandler(http.server.BaseHTTPRequestHandler):
        def _forward(self):
            target = f"{gateway_url}/api/tunnel/proxy/{local_port}{self.path}"
            length = int(self.headers.get("Content-Length", "0"))
            body = self.rfile.read(length) if length > 0 else None
            headers = {"Authorization": f"Bearer {token}"}
            for k, v in self.headers.items():
                if k.lower() not in ("host", "connection", "accept-encoding", "content-length"):
                    headers[k] = v

            req = urllib.request.Request(target, data=body, headers=headers, method=self.command)
            try:
                with urllib.request.urlopen(req, timeout=35) as resp:
                    data = resp.read()
                    self.send_response(resp.status)
                    for k, v in resp.getheaders():
                        if k.lower() not in ("transfer-encoding", "connection", "content-length"):
                            self.send_header(k, v)
                    self.send_header("Content-Length", str(len(data)))
                    self.end_headers()
                    self.wfile.write(data)
            except urllib.error.HTTPError as e:
                data = e.read()
                self.send_response(e.code)
                self.send_header("Content-Type", e.headers.get("Content-Type", "text/plain; charset=utf-8"))
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
            except Exception as e:
                msg = f"Super-Agent tunnel error: {e}\n".encode("utf-8")
                self.send_response(502)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(msg)))
                self.end_headers()
                self.wfile.write(msg)

        do_GET = _forward
        do_POST = _forward
        do_PUT = _forward
        do_PATCH = _forward
        do_DELETE = _forward
        do_HEAD = _forward
        do_OPTIONS = _forward

        def log_message(self, fmt, *args):
            sys.stderr.write(f"[sa-preview :{cloud_port}->local:{local_port}] {fmt % args}\n")

    socketserver.ThreadingTCPServer.allow_reuse_address = True
    with socketserver.ThreadingTCPServer(("127.0.0.1", cloud_port), PreviewHandler) as httpd:
        print(f"Super-Agent preview active: http://localhost:{cloud_port}  ==>  local machine port {local_port}", flush=True)
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
