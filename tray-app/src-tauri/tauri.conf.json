{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super-Agent",
  "version": "0.1.0",
  "identifier": "com.superagent.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Super-Agent 本地伴侣",
        "width": 560,
        "height": 640,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/sync-agent"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
